diff --git a/scripts/build-xnu-4k-baseline.sh b/scripts/build-xnu-4k-baseline.sh
index 5815dd9..9c07ddc 100755
--- a/scripts/build-xnu-4k-baseline.sh
+++ b/scripts/build-xnu-4k-baseline.sh
@@ -31,22 +31,85 @@ if [ ! -x .cache/fakeroot/usr/local/libexec/availability.pl ]; then
     OBJROOT="$ROOT/build/availability" SYMROOT="$ROOT/build/availability" \
     DSTROOT="$ROOT/.cache/fakeroot" CMAKE="$(command -v cmake)" NINJA="$(command -v ninja)"
 fi
+# The patches are written for a source line: the XNU version feeds.toml pins. A line whose
+# structure differs carries an overlay in patches/xnu-<major>/. A patch of the same name there
+# replaces the base patch, and skip.txt names base patches the line does not have, with the
+# reason. Nothing is skipped silently: every omission is printed and checked below.
+XNU_PATCH_LINE="xnu-${XNU_VERSION%%.*}"
+XNU_PATCH_OVERLAY="$ROOT/patches/$XNU_PATCH_LINE"
+patch_skipped() {
+  local name=$1 reason
+  [ -f "$XNU_PATCH_OVERLAY/skip.txt" ] || return 1
+  reason=$(awk -F: -v n="$name" '$1 ~ "^[[:space:]]*" n "[[:space:]]*$" { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$XNU_PATCH_OVERLAY/skip.txt")
+  [ -n "$reason" ] || return 1
+  echo "skip $name: $reason"
+  return 0
+}
+effective_patch() {
+  local name
+  name=$(basename "$1" .patch)
+  if [ -f "$XNU_PATCH_OVERLAY/$name.patch" ]; then
+    echo "$XNU_PATCH_OVERLAY/$name.patch"
+  else
+    echo "$1"
+  fi
+}
+apply_patch() {
+  local patch
+  patch=$(effective_patch "$1")
+  if git -C .cache/xnu-work apply --reverse --check "$patch" >/dev/null 2>&1; then
+    return 0
+  fi
+  git -C .cache/xnu-work apply --check "$patch"
+  git -C .cache/xnu-work apply "$patch"
+}
 # The optional observation hooks overlap existing root/exec patch context.
 # Remove them first so earlier independent patches retain their idempotent checks.
 # The same holds for the boot-time GPU addon mount and the staged system apps copy (zzy), which edit the owner Data mount function
 # inside the systemos patch. Reverse newest first; the loop below re-applies them in name order.
 for LATE_PATCH in "$ROOT/patches/xnu/zzz-boot-progress.patch" "$ROOT/patches/xnu/zzy-staged-system-apps.patch" \
     "$ROOT/patches/xnu/zzy-native-gpu-addon-mount.patch"; do
+  patch_skipped "$(basename "$LATE_PATCH" .patch)" && continue
+  LATE_PATCH=$(effective_patch "$LATE_PATCH")
   if git -C .cache/xnu-work apply --reverse --check "$LATE_PATCH" >/dev/null 2>&1; then
     git -C .cache/xnu-work apply --reverse "$LATE_PATCH"
   fi
 done
-for PATCH in "$ROOT"/patches/xnu/*.patch "$ROOT"/kits/NativePrelink/patches/*.patch; do
-  if ! git -C .cache/xnu-work apply --reverse --check "$PATCH" >/dev/null 2>&1; then
-    git -C .cache/xnu-work apply --check "$PATCH"
-    git -C .cache/xnu-work apply "$PATCH"
-  fi
+for PATCH in "$ROOT"/patches/xnu/*.patch; do
+  patch_skipped "$(basename "$PATCH" .patch)" && continue
+  apply_patch "$PATCH"
+done
+# Overlay patches without a base counterpart add to the line.
+for PATCH in "$XNU_PATCH_OVERLAY"/*.patch; do
+  [ -e "$PATCH" ] || continue
+  [ -e "$ROOT/patches/xnu/$(basename "$PATCH")" ] && continue
+  apply_patch "$PATCH"
+done
+# The prelink kit patches are named for the version they patch; another line does not take them.
+for PATCH in "$ROOT"/kits/NativePrelink/patches/*.patch; do
+  [ -e "$PATCH" ] || continue
+  case "$(basename "$PATCH")" in
+    xnu-*)
+      case "$(basename "$PATCH")" in
+        "xnu-$XNU_VERSION-"*) ;;
+        *) echo "skip $(basename "$PATCH"): other source line"; continue ;;
+      esac
+      ;;
+  esac
+  apply_patch "$PATCH"
 done
+# A skip list that names a patch the base tree no longer has would hide a lost patch.
+if [ -f "$XNU_PATCH_OVERLAY/skip.txt" ]; then
+  while IFS=: read -r NAME REASON; do
+    case "$NAME" in ''|'#'*) continue ;; esac
+    NAME=${NAME//[[:space:]]/}
+    [ -n "$NAME" ] || continue
+    if [ ! -f "$ROOT/patches/xnu/$NAME.patch" ]; then
+      echo "error: $XNU_PATCH_OVERLAY/skip.txt skips $NAME, which patches/xnu/ does not have" >&2
+      exit 1
+    fi
+  done < "$XNU_PATCH_OVERLAY/skip.txt"
+fi
 export XNU_AVAILABILITY_PL=$ROOT/.cache/fakeroot/usr/local/libexec/availability.pl
 python3 scripts/prepare-xnu-source.py
