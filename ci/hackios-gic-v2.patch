+	__builtin_arm_wsr64("CNTV_CTL_EL0", 0);
+	__builtin_arm_wsr64("CNTP_CTL_EL0", 0);
+	__builtin_arm_isb(ISB_SY);
+	gic_write32(gicd_base + GICD_ICPENDR(0), 0xffffffffu);
+	gic_write32(gicd_base + GICD_ICACTIVER(0), 0xffffffffu);
+
+	gic_v2_group(0, mine);
+	gic_write32(gicd_base + GICD_ISENABLER(0), mine);
+
+	/* distributor: enable this side's group */
+	uint32_t group_enable = gic_v2_secure ? GICD2_CTLR_ENABLE_G0 : GICD2_CTLR_ENABLE_G1;
+	uint32_t ctlr = gic_read32(gicd_base + GICD2_CTLR);
+	if (!(ctlr & group_enable)) {
+		gic_write32(gicd_base + GICD2_CTLR, ctlr | group_enable);
+	}
+
+	/* CPU interface last, so nothing is passed on before all of the above is in place */
+	uint32_t cpu_enable = gic_v2_secure ? GICC_CTLR_ENABLE : GICC_CTLR_ENABLE_G1;
+
+	gic_write32(gicc_base + GICC_PMR, 0xff);
+	gic_write32(gicc_base + GICC_BPR, 0);
+	if (!(gic_read32(gicc_base + GICC_CTLR) & cpu_enable)) {
+		gic_write32(gicc_base + GICC_CTLR, gic_read32(gicc_base + GICC_CTLR) | cpu_enable);
+	}
+
+	kprintf("gic: v2 (%s), distributor %p, cpu %d's interface %p, virtual timer on PPI %d\n",
+	    gic_v2_secure ? "secure EL1, Group 0" : "non-secure EL1, Group 1",
+	    (void *)gicd_base, cpu, (void *)gicc_base, GIC_INTID_VTIMER);
+}
+
+/* Per-CPU bring-up: every processor calls this for itself, the boot processor first. */
+void
+gic_v3_irq_cpu_init(void)
+{
+	int cpu = cpu_number();
+	uint32_t mine = 1u << GIC_INTID_VTIMER;
+
+	gic_cpu_phys_id[cpu] = (uint32_t)(__builtin_arm_rsr64("MPIDR_EL1") & 0xffffff);
+
+	if (gicd_base == 0) {
+		DTEntry entry;
+		void const *prop;
+		unsigned int prop_size;
+
+		if (SecureDTLookupEntry(NULL, "/arm-io/gic", &entry) != kSuccess ||
+		    SecureDTGetProperty(entry, "reg", &prop, &prop_size) != kSuccess ||
+		    prop_size < 4 * sizeof(uint64_t)) {
+			panic("gic: no usable /arm-io/gic node in the device tree");
+		}
+		uint64_t const *reg = prop;
+		vm_offset_t soc_base = pe_arm_get_soc_base_phys();
+
+		simple_lock_init(&gic_spi_lock, 0);
+		gicd_base = ml_io_map(soc_base + reg[0], reg[1]);
+		if (gicd_base == 0) {
+			panic("gic: cannot map the distributor");
+		}
+		/*
+		 * Which of the two it is. The device tree says (the loader writes the matching name),
+		 * and PIDR2[7:4] -- 2 for a GICv2, 3 for a GICv3 -- is the check on it: a GICv2 with an
+		 * empty identification block (QEMU's, as it turns out) reads 0 there.
+		 */
+		char const *compatible = NULL;
+		unsigned int compatible_size = 0;
+		uint32_t pidr2 = (gic_read32(gicd_base + GICD2_PIDR2) >> 4) & 0xf;
+
+		if (SecureDTGetProperty(entry, "compatible", (void const **)&compatible, &compatible_size) != kSuccess) {
+			compatible = NULL;
+		}
+		/*
+		 * The whole list, not just its first name: a Snapdragon's node says
+		 * "qcom,msm-qgic2", "arm,gic-2", and "arm,gic-400" is a GICv2 as well.
+		 */
+		bool says_v2 = compatible != NULL && (gic_compatible_has(compatible, compatible_size, "arm,gic-2") ||
+		    gic_compatible_has(compatible, compatible_size, "arm,gic-400") ||
+		    gic_compatible_has(compatible, compatible_size, "qcom,msm-qgic2"));
+		bool says_v3 = compatible != NULL && gic_compatible_has(compatible, compatible_size, "arm,gic-v3");
+
+		kprintf("gic: compatible \"%s\", PIDR2 revision %u, second region %llx/%llx\n",
+		    compatible ? compatible : "(none)", pidr2, reg[2], reg[3]);
+		/* the device tree first: QEMU's GICv3 leaves its identification block empty */
+		if (says_v2 || (!says_v3 && pidr2 == 2)) {
+			gic_version = 2;
+		} else if (says_v3 || pidr2 == 3) {
+			gic_version = 3;
+		} else {
+			panic("gic: unsupported controller: compatible \"%s\", PIDR2 revision %u (distributor %p)",
+			    compatible ? compatible : "", pidr2, (void *)gicd_base);
+		}
+		if (gic_version == 2) {
+			/*
+			 * Which side of the security extensions this EL1 is on. From the non-secure side
+			 * the group registers are read-only zero; on the secure side, and on a controller
+			 * without the extensions at all (where the bit means nothing but still reads back),
+			 * a write sticks. The probe bit is one no driver uses, and it is put back.
+			 */
+			uint32_t probe = 1u << 2;
+			uint32_t before = gic_read32(gicd_base + GICD_IGROUPR(0));
+
+			gic_write32(gicd_base + GICD_IGROUPR(0), before | probe);
+			gic_v2_secure = (gic_read32(gicd_base + GICD_IGROUPR(0)) & probe) != 0;
+			gic_write32(gicd_base + GICD_IGROUPR(0), before);
+
+			gicc_base = ml_io_map(soc_base + reg[2], reg[3]);
+			if (gicc_base == 0) {
+				panic("gic: cannot map the CPU interface");
+			}
+		} else {
+			gicr_base = ml_io_map(soc_base + reg[2], reg[3]);
+			gicr_size = reg[3];
+			if (gicr_base == 0) {
+				panic("gic: cannot map the redistributor");
+			}
+		}
+	}
+
+	/*
+	 * Before anything is enabled: an interrupt that arrives with no handler to end it is taken
+	 * again the moment the vector returns, for ever.
+	 */
+	ml_install_interrupt_handler(NULL, 0, NULL, gic_irq_handler, NULL);
+
+	if (gic_version == 2) {
+		gic_v2_cpu_init(cpu, mine);
+	} else {
+		gic_v3_cpu_init(cpu, mine);
+	}
+}
+
 #endif /* GENERIC_GIC_V3_IRQ */
