+/*
+ * A GICv2 machine: the firmware leaves its interrupt controller enabled with the timers it used
+ * still pending. The kernel installs its interrupt handler some way into its own start-up, and an
+ * interrupt that arrives before that has no handler to end it: a level-triggered one, like the
+ * timer, would then be signalled again the moment the handler returns, for ever. Nothing of the
+ * firmware's needs to survive into the kernel (it re-enables what it uses), so the controller is
+ * left quiet and the virtual timer stopped; loader_save_ctx() has already put both away for the
+ * return path.
+ */
+static void
+gic2_handover(const struct platform *plat)
+{
+	volatile uint32_t *dist, *cpu;
+
+	if (plat->gic_cpu == 0) {
+		return;
+	}
+	dist = (volatile uint32_t *)plat->gic_dist;
+	cpu = (volatile uint32_t *)plat->gic_cpu;
+	cpu[0] = 0;                     /* GICC_CTLR: neither group enabled */
+	dist[0x180 / 4] = 0xffffffffu;   /* GICD_ICENABLER0: the SGIs and private interrupts */
+	dist[0x280 / 4] = 0xffffffffu;   /* GICD_ICPENDR0 */
+	dist[0x380 / 4] = 0xffffffffu;   /* GICD_ICACTIVER0 */
+	__asm__ volatile ("msr cntv_ctl_el0, xzr\nisb");
+}
