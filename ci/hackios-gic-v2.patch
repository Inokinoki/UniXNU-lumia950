+gic_v2_cpu_init(int cpu, uint32_t mine)
+{
+	/* the interrupts between processors, where there is more than one */
+	if (ml_get_cpu_count() > 1) {
+		uint32_t sgis = (1u << GIC_SGI_SIGNAL) | (1u << GIC_SGI_STOP);
